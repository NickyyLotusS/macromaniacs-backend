{
  "name": "macromaniacs-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ tests/ scripts/",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:cov": "npm test -- --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "npm test -- --runInBand tests/e2e/",
    "test:integration": "RUN_DATABASE_TESTS=true npm test -- --runInBand tests/integration/database.spec.ts",
    "test:sql": "ts-node scripts/run-sql.ts",
    "db:verify": "ts-node scripts/verify-schema.ts",
    "db:drift": "ts-node scripts/schema-drift.ts",
    "docs:dbml": "ts-node scripts/verify-dbml.ts",
    "db:backup": "ts-node scripts/backup.ts",
    "db:backup:verify": "ts-node scripts/verify-restored-backup.ts",
    "db:baseline": "ts-node scripts/register-baseline.ts",
    "db:local": "ts-node scripts/local-db.ts",
    "seed": "ts-node src/integrations/database/seed.ts",
    "seed:prod": "node dist/integrations/database/seed.js",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:generate": "ts-node scripts/generate-migration.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/integrations/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/integrations/database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/integrations/database/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/integrations/database/data-source.js",
    "migration:show:prod": "typeorm migration:show -d dist/integrations/database/data-source.js",
    "migration:revert:prod": "typeorm migration:revert -d dist/integrations/database/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@dbml/core": "^10.1.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  }
}
