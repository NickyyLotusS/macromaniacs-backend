APP_ENV=development
APP_PORT=3000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_DB=macromaniacs_db
POSTGRES_PORT=5433
POSTGRES_VOLUME=macromaniacs-backend_pgdata
DATABASE_URL=postgresql://postgres:replace-with-your-local-password@localhost:5433/macromaniacs_db
AUTH_SECRET=replace-only-in-your-local-environment
STORAGE_PROVIDER=local
STORAGE_BUCKET=macromaniacs-dev
AI_OCR_PROVIDER=mock
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
