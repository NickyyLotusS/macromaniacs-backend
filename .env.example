APP_ENV=development
# Desenvolvimento local usa APP_PORT. Railway/Render podem fornecer PORT.
APP_PORT=3000
# PORT=3000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_DB=macromaniacs_db
POSTGRES_PORT=5433
POSTGRES_VOLUME=macromaniacs-backend_pgdata
DATABASE_URL=postgresql://postgres:replace-with-your-local-password@localhost:5433/macromaniacs_db
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:5173
STORAGE_PROVIDER=local
STORAGE_BUCKET=macromaniacs-dev
AI_OCR_PROVIDER=mock
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_ENABLED=true
OPEN_FOOD_FACTS_USER_AGENT=MacroManiacs/0.0.1 (backend contact: replace@example.com)
# USDA_API_KEY=
USDA_BASE_URL=https://api.nal.usda.gov
FOOD_PROVIDER_TIMEOUT_MS=3000
FOOD_PROVIDER_RETRIES=1
FOOD_PROVIDER_CIRCUIT_FAILURES=3
FOOD_PROVIDER_CIRCUIT_RESET_MS=30000
TERMS_VERSION=2026-11-08
DEFAULT_TIMEZONE=UTC
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10
# Ative somente atrás de um proxy reverso confiável.
TRUST_PROXY=false
